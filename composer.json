{
    "name": "tuxonice/packsolver",
    "description": "A tool to solve PHP Composer dependency conflicts",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "TuxOnIce",
            "email": "example@example.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "composer/composer": "^2.0",
        "symfony/console": "^6.0",
        "symfony/process": "^6.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "squizlabs/php_codesniffer": "^3.6"
    },
    "autoload": {
        "psr-4": {
            "TuxOnIce\\PackSolver\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "TuxOnIce\\PackSolver\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/packsolver"
    ],
    "scripts": {
        "test": "phpunit",
        "cs": "phpcs",
        "cs-fix": "phpcbf"
    }
}
